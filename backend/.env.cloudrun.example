# =============================================================================
# Cloud Run deploy config for myTask API
# Copy to .env.cloudrun (gitignored) and fill in real values:
#   cp .env.cloudrun.example .env.cloudrun
# Then:
#   ./deploy-cloud-run.sh
# =============================================================================

# --- GCP / Cloud Run ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-south1
CLOUD_RUN_SERVICE=mytask-api
ARTIFACT_REPO=mytask-api
IMAGE_NAME=mytask-api
# IMAGE_TAG=          # optional; default is timestamp
CLOUD_RUN_MEMORY=1Gi
CLOUD_RUN_CPU=1
CLOUD_RUN_MAX_INSTANCES=3
CLOUD_RUN_MIN_INSTANCES=0
CLOUD_RUN_ALLOW_UNAUTH=true
CLOUD_RUN_TIMEOUT=300

# --- App / URLs / CORS ---
APP_NAME=myTask
CLIENT_URL=https://your-project.web.app/
SERVER_URL=https://PLACEHOLDER.run.app/api
CORS_ORIGINS=https://your-project.web.app
SOCKETIO_CORS_ORIGINS=https://your-project.web.app

# --- Runtime ---
START_SERVER=true
RUN_WORKERS=true
CRON_SECRET=change-me

# --- Database (Cloud SQL) ---
# CLOUDSQL_INSTANCE=your-project:asia-south1:mytask-mysql
CLOUDSQL_INSTANCE=mytask-72398:asia-south1:mytask-db
DB_HOST=/cloudsql/mytask-72398:asia-south1:mytask-db
DB_NAME=mytask
DB_USER=mytask
DB_PASSWORD=change-me
DB_PORT=3306
DB_DIALECT=mysql
# For Cloud SQL socket (when CLOUDSQL_INSTANCE is set), use e.g.:
# DB_HOST=/cloudsql/your-project:asia-south1:mytask-mysql

# --- Redis / VPC ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Optional AUTH (Memorystore can enable Redis AUTH)
# REDIS_PASSWORD=
# REDIS_TLS=false
# Google Memorystore + Cloud Run (same region as CLOUD_RUN):
# 1) Create Memorystore Redis → copy Primary IP → REDIS_HOST=10.x.x.x
# 2) Create Serverless VPC Access connector → VPC_CONNECTOR=projects/.../connectors/mytask-vpc
# 3) See docs/DEPLOY_REDIS_MEMORYSTORE.md
# VPC_CONNECTOR=projects/mytask-72398/locations/asia-south1/connectors/mytask-vpc
# VPC_EGRESS=private-ranges-only

# --- Realtime (Socket.IO) ---
SOCKETIO_TOKEN=change-me

# --- Auth / Firebase ---
FIREBASE_API_URL=https://identitytoolkit.googleapis.com/v1
FIREBASE_API_KEY=
FIREBASE_USE_ADMIN_LINKS=false
# Do NOT put serviceAccountKey.json in the Docker image.
# deploy-cloud-run.sh auto-loads ./serviceAccountKey.json as FIREBASE_SERVICE_ACCOUNT_BASE64.
# Or set FIREBASE_SERVICE_ACCOUNT_BASE64 yourself (base64 -i serviceAccountKey.json | tr -d '\n').

# --- Email ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRODUCT_PRO=prod_...
