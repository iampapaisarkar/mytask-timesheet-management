import type { MobileEnv } from "./env.types";

/**
 * Local secrets / device-specific overrides (gitignored).
 * Copy to `env.local.ts` and fill values:
 *   cp src/config/env.local.ts.example src/config/env.local.ts
 */
export const ENV_LOCAL: Partial<MobileEnv> = {
  API_BASE_URL: "http://localhost:8080/api",
  // Physical device: http://192.168.x.x:3002/api
  // Android emulator: http://10.0.2.2:3002/api

  FIREBASE_API_KEY: "",
  FIREBASE_AUTH_DOMAIN: "",
  FIREBASE_PROJECT_ID: "",
  FIREBASE_STORAGE_BUCKET: "",
  FIREBASE_MESSAGING_SENDER_ID: "",
  FIREBASE_APP_ID: "",

  GOOGLE_WEB_CLIENT_ID: "",
  GOOGLE_IOS_CLIENT_ID: "",

  // Required for Places Autocomplete in JS (ENV.GOOGLE_MAPS_API_KEY) AND native Maps SDK.
  // Enable Places API + Maps SDK on the key. Also mirror in Info.plist GMSApiKey /
  // Android res/values/strings.xml google_maps_api_key.
  GOOGLE_MAPS_API_KEY: "",

  STRIPE_PUBLISHABLE_KEY: "",
};
