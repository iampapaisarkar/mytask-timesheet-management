# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# CocoaPods trunk hosts TSLocationManager (Transistorsoft). Keep CDN explicit so
# `pod install --repo-update` can resolve RNBackgroundGeolocation → TSLocationManager.
source 'https://cdn.cocoapods.org/'

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Required by firebase-ios-sdk / @react-native-firebase (v15+).
# Override with USE_FRAMEWORKS=dynamic only if you know you need it.
# Disable SPM: firebase-ios-sdk SPM products are dynamic-only and conflict with
# static linkage (duplicate symbols). CocoaPods + static frameworks is the
# supported combo for RN CLI + New Architecture.
$RNFirebaseDisableSPM = true
linkage = ENV['USE_FRAMEWORKS'] || 'static'
Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
use_frameworks! :linkage => linkage.to_sym
$RNFirebaseAsStaticFramework = true

target 'MyTaskMobile' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Google Maps provider for iOS (same path as autolinking — required for
  # Fabric RNMapsGoogleMapView). Do not use Apple Maps.
  pod 'react-native-maps/Google', :path => '../../node_modules/react-native-maps'

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
