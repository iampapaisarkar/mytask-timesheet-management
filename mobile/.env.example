# =============================================================================
# myTask Mobile (React Native CLI) — Template
# Runtime values are edited in mobile/src/config/env.ts (not auto-loaded from .env yet).
# Keep this file as a checklist of required keys.
# =============================================================================

# --- API ---
API_BASE_URL=http://localhost:8080/api

# --- Firebase (JS SDK) ---
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# --- Google Sign-In (native) ---
# Web OAuth client ID from Firebase → Authentication → Google (required for ID token)
GOOGLE_WEB_CLIENT_ID=
# iOS OAuth client ID from GoogleService-Info.plist CLIENT_ID (optional with plist)
GOOGLE_IOS_CLIENT_ID=
