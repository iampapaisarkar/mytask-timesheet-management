# =============================================================================
# myTask Web (Vite) — Template
# Copy to web/.env and fill values.
# Dev Firebase web config can be recovered from origianl-frontend-vue-js/firebase-messaging-sw.js
# (client config is public; use the same project as backend FIREBASE_API_KEY).
# =============================================================================

# --- API ---
VITE_API_BASE_URL=http://localhost:8080/api

# --- Firebase ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Web Push (FCM) ---
# Firebase Console → Project settings → Cloud Messaging → Web Push certificates
VITE_FIREBASE_VAPID_KEY=

# --- Google Maps / Places ---
# Enable in Google Cloud Console: Maps JavaScript API, Places API
# Restrict key by HTTP referrer (e.g. http://localhost:9000/*)
VITE_GOOGLE_MAPS_API_KEY=
